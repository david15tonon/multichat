# Copier en .env et renseigner. Ne jamais commiter .env.

# Généré par : python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
DATABASE_URL=sqlite+aiosqlite:///./multichat.db
DEBUG=True

# ---------------------------------------------------------------------------
# Traduction — n'importe quelle API compatible OpenAI (/chat/completions).
# Clé absente : la messagerie fonctionne, les messages arrivent non traduits.
# ---------------------------------------------------------------------------

# Z.ai / Zhipu (GLM) — gratuit, sans carte bancaire, sans expiration.
# Palier gratuit limité à 1 requête simultanée. Clé : https://z.ai
LLM_API_KEY=
LLM_BASE_URL=https://api.z.ai/api/paas/v4
LLM_MODEL=glm-4.5-flash

# --- Autres fournisseurs : décommenter le bloc voulu ---

# Qwen / Alibaba DashScope — 1 M jetons gratuits par modèle, 90 jours.
# Excellent en chinois, japonais et arabe. Endpoint international (Singapour).
# LLM_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus

# Groq — très rapide, palier gratuit généreux. Clé : https://console.groq.com
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile
